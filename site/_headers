# Cloudflare Pages headers (https://developers.cloudflare.com/pages/configuration/headers/)
# The CSP is the page's own promise, enforced by the browser: no scripts, no
# connections, no fonts or images from anywhere but this site.
# BETA: X-Robots-Tag keeps search engines out. Remove it (and robots.txt, and
# the <meta name="robots"> in each page) at public launch.
/*
  X-Robots-Tag: noindex
  Content-Security-Policy: default-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; script-src 'none'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: DENY
